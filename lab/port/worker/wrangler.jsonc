{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "datastar-port",
  "main": "dist/entry.mjs",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "observability": { "enabled": true },
  // No LAB_DEV. Setting it to "1" opens the /dev/* routes the verification
  // suites drive — including one that creates an account and one that returns
  // the last OTP, which together walk straight past the login. That is fine
  // against a local server and not fine on a public URL, so the deployment
  // runs without it and the suites run against `wrangler dev` instead.
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "App" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["App"] }]
}
